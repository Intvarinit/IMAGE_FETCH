<?xml version="1.0" encoding="utf-8"?>
<!-- 危险按钮：删除这类不可逆操作，用红色文字与描边提示后果。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_muted" />
            <corners android:radius="@dimen/radius_control" />
            <stroke
                android:width="1dp"
                android:color="@color/outline" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/danger_soft" />
            <corners android:radius="@dimen/radius_control" />
            <stroke
                android:width="1dp"
                android:color="@color/danger" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="@dimen/radius_control" />
            <stroke
                android:width="1dp"
                android:color="@color/danger_outline" />
        </shape>
    </item>
</selector>
