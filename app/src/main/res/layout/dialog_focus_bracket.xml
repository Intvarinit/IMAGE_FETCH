<?xml version="1.0" encoding="utf-8"?>
<!--
  「对焦包围」设置面板（机内 0xD208 FocusShiftSetting）。
  与 HDR 面板同样的结构：只读报告 + 参数输入 + 读取/写入两个动作。按钮放在视图里而不是
  AlertDialog 的按钮位上，因为报告要一直在屏幕可见处，而默认按钮按下会关掉弹窗。
  每个参数各占一行并在下面跟一句说明——常量名（张数/对焦增量）从字面看不出单位与证据等级，
  说明要贴着参数走，用户不必滑到底部再对上号。
  根布局用 ScrollView：报告 + 四行参数 + 按钮 + 提示叠起来会超过屏幕高度，
  AlertDialog 不会自动让自定义视图可滚动，底部按钮会被挤出可视区。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/focusReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/focus_enabled_label"
            android:textColor="@color/ink"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/focusEnabled"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/focus_enabled_label"
                android:inputType="number"
                android:maxLines="1" />

            <Button
                android:id="@+id/focusEnabledOff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/focus_enabled_off"
                android:textSize="12sp" />

            <Button
                android:id="@+id/focusEnabledOn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/focus_enabled_on"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/focus_enabled_hint"
            android:textColor="#6B7280"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/focus_count_label"
            android:textColor="@color/ink"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/focusCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/focus_count_label"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/focus_count_hint"
            android:textColor="#6B7280"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/focus_increment_label"
            android:textColor="@color/ink"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/focusIncrement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/focus_increment_label"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/focus_increment_hint"
            android:textColor="#6B7280"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/focus_smoothing_label"
            android:textColor="@color/ink"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/focusSmoothing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/focus_smoothing_label"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/focus_smoothing_hint"
            android:textColor="#6B7280"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/focusRead"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/focus_read"
                android:textSize="12sp" />

            <Button
                android:id="@+id/focusWrite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/focus_write"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/focusShoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/focus_write_and_open_capture"
            android:textSize="12sp" />

        <Button
            android:id="@+id/focusCalculator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/focus_calculator"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/focus_reference_title"
            android:textColor="@color/ink"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/focus_reference"
            android:textColor="#6B7280"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/focus_reference_tips"
            android:textColor="#6B7280"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/focus_hint"
            android:textColor="#6B7280"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
