<?xml version="1.0" encoding="utf-8"?>
<!-- 遥控拍摄面板：实时取景预览 + 快门/光圈/ISO 逐档调整 + 触发拍摄并取回。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingTop="4dp"
    android:paddingRight="12dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/liveViewImage"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="#000000"
        android:contentDescription="@string/live_view_hint"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/liveViewStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/live_view_starting"
        android:textColor="#6B7280"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/liveViewTapHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/live_view_tap_focus_hint"
        android:textColor="#6B7280"
        android:textSize="11sp" />

    <include
        android:id="@+id/shutterRow"
        layout="@layout/view_exposure_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <include
        android:id="@+id/apertureRow"
        layout="@layout/view_exposure_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/isoRow"
        layout="@layout/view_exposure_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:text="@string/af_mode_label"
            android:textColor="@color/ink"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/afMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/af_mode_label"
            android:minWidth="120dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/exposure_hint"
        android:textColor="#6B7280"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/live_view_size_label"
            android:textColor="@color/ink"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/liveViewSize"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/live_view_size_label"
            android:minWidth="72dp" />

        <Button
            android:id="@+id/captureAutofocus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minHeight="44dp"
            android:text="@string/autofocus" />
    </LinearLayout>

    <Button
        android:id="@+id/captureShoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="48dp"
        android:text="@string/capture_and_fetch" />
</LinearLayout>
