<?xml version="1.0" encoding="utf-8"?>
<!--
  全屏看图页：黑底大图 + 顶部文件名/序号 + 底部参数与选中切换。
  由 PhotoViewerDialog 承载，图片可双指/双击缩放，未放大时左右滑动切换同页照片。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/previewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <com.imagefetch.ui.ZoomableImageView
        android:id="@+id/previewImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_l"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_s"
        android:paddingBottom="@dimen/space_s">

        <TextView
            android:id="@+id/previewTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/previewCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_marginEnd="@dimen/space_s"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/previewClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#33FFFFFF"
            android:minHeight="36dp"
            android:minWidth="0dp"
            android:paddingStart="@dimen/space_m"
            android:paddingEnd="@dimen/space_m"
            android:text="@string/close"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_l"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_l"
        android:paddingBottom="@dimen/space_s">

        <TextView
            android:id="@+id/previewInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="horizontal">

            <Button
                android:id="@+id/previewDownload"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/preview_download" />

            <Button
                android:id="@+id/previewDelete"
                style="@style/Widget.Button.Danger"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:text="@string/preview_delete" />

            <Button
                android:id="@+id/previewToggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:text="@string/preview_toggle_select" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
