<?xml version="1.0" encoding="utf-8"?>
<!-- 曝光参数的一行：名称 + 减档 + 当前档位 + 加档。三行（快门/光圈/ISO）由 dialog_capture 复用。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/rowLabel"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:textColor="@color/ink"
        android:textSize="13sp" />

    <Button
        android:id="@+id/rowMinus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/exposure_minus"
        android:minWidth="52dp"
        android:text="@string/exposure_minus" />

    <TextView
        android:id="@+id/rowValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:ellipsize="end"
        android:focusable="true"
        android:gravity="center"
        android:maxLines="1"
        android:minHeight="40dp"
        android:text="@string/exposure_unknown"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/rowPlus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/exposure_plus"
        android:minWidth="52dp"
        android:text="@string/exposure_plus" />
</LinearLayout>
