<?xml version="1.0" encoding="utf-8"?>
<!--
  「景深合成自检」面板（临时验证页，用于确认手机端 Python + OpenCV 能跑通）。
  内容是只读报告 + 合成效果图 + 重新运行；与相机无关，不需要连接也能用。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="520dp"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/stackReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/stackImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/stack_check_title"
            android:visibility="gone" />

        <Button
            android:id="@+id/stackRerun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/stack_check_rerun"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/stack_check_hint"
            android:textColor="#6B7280"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>