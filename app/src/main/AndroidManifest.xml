<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- WifiNetworkSpecifier 的 requestNetwork 需要它；缺了会直接抛 SecurityException，
         表现为「填了 SSID 却从不弹加入网络框、总是回退到系统当前 Wi-Fi」。 -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 连接期间持有 WifiLock：避免息屏待机时 Wi-Fi 休眠导致大文件传输中断 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 会话保活前台服务（M2）：保住进程优先级，避免退后台时会话被系统回收 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+ 通知权限：被拒不影响前台服务运行，只是通知不展示 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 加入相机 Wi‑Fi（M4）：API 33+ 用 NEARBY_WIFI_DEVICES，并在清单里声明不用于定位 -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <!-- 定位：读当前 Wi‑Fi 名称（WifiInfo#getSSID）与扫描结果的敏感字段在 13+ 仍要求它；
         同时兼容 API 32 及以下 WifiNetworkSpecifier 的声明要求。选网时按需申请。 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 蓝牙唤醒相机 Wi‑Fi（对齐官方 Camera Connect 的 BLE 交接）：
         12+ 用 BLUETOOTH_SCAN/CONNECT，11 及以下用旧权限 + 定位。 -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- 仅 Android 9 及以下需要：API 29+ 走分区存储导出到相册，无需存储权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- 胶片模拟的全尺寸导出要在内存里同时持有源图、像素缓冲与成品位图
         （4096 边长源图约 45MB，峰值 130MB 以上），默认堆容易 OOM，申请大堆。 -->
    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 相机插入 USB 时把本应用列入候选：用户选中即完成设备授权 -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!-- 会话保活前台服务（M2）：只保进程 + 显示状态，不持有会话协调器 -->
        <service
            android:name=".CameraConnectionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
